<Page
    x:Class="optimizerDuck.UI.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="ThisPage"
    Title="ProfilesPage"
    d:DataContext="{d:DesignInstance pages:ProfilesPage}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel>
            <StackPanel Style="{StaticResource PageHeaderStyle}">
                <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc Profiles.Header.Title}" />
                <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc Profiles.Header.Description}" />
            </StackPanel>

            <!--  Presets  -->
            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <ui:TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{ext:Loc Profiles.Presets.Header}" />
                <ItemsControl ItemsSource="{Binding ViewModel.Presets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Flash24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <ui:TextBlock
                                            FontTypography="BodyStrong"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />
                                        <ui:TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Caption"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding CountText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.ViewModel.PreviewPresetCommand, ElementName=ThisPage}"
                                        CommandParameter="{Binding}"
                                        Content="{ext:Loc Profiles.Button.Preview}"
                                        Cursor="Hand"
                                        Icon="{ui:SymbolIcon Eye24}" />
                                    <ui:Button
                                        Appearance="Primary"
                                        Command="{Binding DataContext.ViewModel.ApplyPresetCommand, ElementName=ThisPage}"
                                        CommandParameter="{Binding}"
                                        Content="{ext:Loc Profiles.Button.Apply}"
                                        Cursor="Hand"
                                        Icon="{ui:SymbolIcon Play24}" />
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Import / export  -->
            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <ui:TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{ext:Loc Profiles.File.Header}" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowExportUp24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock
                                FontTypography="BodyStrong"
                                Text="{ext:Loc Profiles.Export.Title}"
                                TextWrapping="Wrap" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{ext:Loc Profiles.Export.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button
                        Command="{Binding ViewModel.ExportCommand}"
                        Content="{ext:Loc Profiles.Export.Button}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon Save24}" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowImport24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock
                                FontTypography="BodyStrong"
                                Text="{ext:Loc Profiles.Import.Title}"
                                TextWrapping="Wrap" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{ext:Loc Profiles.Import.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button
                        Command="{Binding ViewModel.ImportCommand}"
                        Content="{ext:Loc Profiles.Import.Button}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                </ui:CardControl>
            </StackPanel>

            <!--  Changes undone by Windows  -->
            <StackPanel Style="{StaticResource SettingsSectionStyle}">
                <ui:TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{ext:Loc Drift.Header}" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock
                                FontTypography="BodyStrong"
                                Text="{Binding ViewModel.DriftStatus}"
                                TextWrapping="Wrap" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{ext:Loc Drift.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,6,0"
                            Command="{Binding ViewModel.CheckDriftCommand}"
                            Content="{ext:Loc Drift.Button.Check}"
                            Cursor="Hand"
                            Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ViewModel.ReapplyDriftCommand}"
                            Content="{ext:Loc Drift.Button.Reapply}"
                            Cursor="Hand"
                            Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                            Visibility="{Binding ViewModel.HasDrift, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ui:CardControl>
                <ItemsControl
                    Margin="48,4,0,0"
                    ItemsSource="{Binding ViewModel.DriftedItems}"
                    Visibility="{Binding ViewModel.HasDrift, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Symbol="Warning16" />
                                <ui:TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
