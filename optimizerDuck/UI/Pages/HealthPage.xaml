<Page
    x:Class="optimizerDuck.UI.Pages.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:system="clr-namespace:optimizerDuck.Services.System"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HealthPage"
    d:DataContext="{d:DesignInstance pages:HealthPage}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Style="{StaticResource PageHeaderStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc Health.Header.Title}" />
                    <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc Health.Header.Description}" />
                </StackPanel>
                <WrapPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.BatteryReportCommand}"
                        Content="{ext:Loc Health.Button.BatteryReport}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon Battery624}"
                        Visibility="{Binding ViewModel.HasBattery, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.ExportCommand}"
                        Content="{ext:Loc Health.Button.Export}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon DocumentArrowDown24}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ViewModel.RefreshCommand}"
                        Content="{ext:Loc Health.Button.Refresh}"
                        Cursor="Hand"
                        Foreground="{DynamicResource AccentButtonForeground}"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </WrapPanel>
            </Grid>
        </StackPanel>

        <controls:LoadingStateOverlay
            Grid.Row="1"
            IsLoading="{Binding ViewModel.IsLoading}"
            Title="{ext:Loc Health.Loading}" />

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ViewModel.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="{Binding Icon}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Check.Status}" Value="{x:Static system:HealthStatus.Good}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Check.Status}" Value="{x:Static system:HealthStatus.Warning}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Check.Status}" Value="{x:Static system:HealthStatus.Bad}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock
                                        FontTypography="BodyStrong"
                                        Text="{Binding Check.Title}"
                                        TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Check.Detail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding StatusText}" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
