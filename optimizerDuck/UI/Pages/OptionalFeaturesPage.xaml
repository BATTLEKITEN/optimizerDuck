<Page
    x:Class="optimizerDuck.UI.Pages.OptionalFeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="OptionalFeaturesPage"
    d:DataContext="{d:DesignInstance pages:OptionalFeaturesPage}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel Style="{StaticResource PageHeaderStyle}">
            <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc OptionalFeatures.Header.Title}" />
            <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc OptionalFeatures.Header.Description}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ToolbarSurfaceStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <ui:TextBox
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="{ext:Loc OptionalFeatures.Search}"
                    Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Command="{Binding ViewModel.RefreshCommand}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon ArrowClockwise24}"
                    ToolTip="{ext:Loc Health.Button.Refresh}" />
            </Grid>
        </Border>

        <ui:InfoBar
            Grid.Row="2"
            Margin="0,0,0,8"
            IsClosable="False"
            IsOpen="{Binding ViewModel.NeedsRestart}"
            Message="{ext:Loc OptionalFeatures.RestartNeeded}"
            Severity="Informational" />

        <controls:LoadingStateOverlay
            Grid.Row="3"
            IsLoading="{Binding ViewModel.IsLoading}"
            Title="{ext:Loc OptionalFeatures.Loading}" />

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding ViewModel.Features}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PuzzlePiece24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding FeatureName}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding IsDescribed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                        Text="{Binding State}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch
                                Command="{Binding DataContext.ViewModel.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                IsEnabled="{Binding DataContext.ViewModel.IsBusy, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}"
                                OffContent="{ext:Loc Common.Toggle.Off}"
                                OnContent="{ext:Loc Common.Toggle.On}" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
