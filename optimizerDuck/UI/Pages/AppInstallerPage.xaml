<Page
    x:Class="optimizerDuck.UI.Pages.AppInstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AppInstallerPage"
    d:DataContext="{d:DesignInstance pages:AppInstallerPage}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Style="{StaticResource PageHeaderStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc AppInstaller.Header.Title}" />
                    <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc AppInstaller.Header.Description}" />
                </StackPanel>
                <ui:Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding ViewModel.InstallSelectedCommand}"
                    Content="{ext:Loc AppInstaller.Install,
                                      {Binding ViewModel.SelectedCount}}"
                    Cursor="Hand"
                    Foreground="{DynamicResource AccentButtonForeground}"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
            </Grid>
        </StackPanel>

        <ui:InfoBar
            Grid.Row="1"
            Margin="0,0,0,8"
            IsClosable="False"
            IsOpen="{Binding ViewModel.IsWingetMissing}"
            Message="{ext:Loc AppInstaller.WingetMissing}"
            Severity="Warning" />

        <controls:LoadingStateOverlay
            Grid.Row="2"
            IsLoading="{Binding ViewModel.IsLoading}"
            Title="{ext:Loc AppInstaller.Loading}" />

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding ViewModel.Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <ui:TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{Binding Title}" />
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,6,6"
                                            Padding="12,10"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <CheckBox Cursor="Hand" IsChecked="{Binding IsSelected}">
                                                <StackPanel>
                                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                                    <ui:TextBlock
                                                        FontTypography="Caption"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding PackageId}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
